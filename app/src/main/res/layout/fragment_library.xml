<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Liked Songs Playlist Header Card -->
    <LinearLayout
        android:id="@+id/library_liked_card"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="#1DB954">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/btn_star_big_on"
                android:tint="#FFFFFF"
                android:contentDescription="Liked" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/liked_songs"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_liked_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 שירים"
                android:textColor="#B3B3B3"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ההיסטוריה והאהובים שלך"
        android:textColor="#B3B3B3"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/library_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="8dp" />

</LinearLayout>
